{
    "name": "backend",
    "version": "1.0.0",
    "description": "Backend API for Real-Time Collaborative Workspace",
    "main": "dist/server.js",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc",
        "start": "node dist/server.js",
        "lint": "eslint .  --ext .ts",
        "type-check": "tsc --noEmit",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "db:migrate": "prisma migrate dev",
        "db:migrate:deploy": "prisma migrate deploy",
        "db:seed": "tsx prisma/seed.ts",
        "db:studio": "prisma studio",
        "db:generate": "prisma generate"
    },
    "dependencies": {
        "express": "^4.18.2",
        "socket.io": "^4.7.0",
        "@prisma/client": "^5.9.1",
        "@hocuspocus/server": "^2.12.0",
        "@hocuspocus/extension-database": "^2.12.0",
        "@hocuspocus/extension-throttle": "^2.12.0",
        "bcryptjs": "^2.4.3",
        "jsonwebtoken": "^9.0.2",
        "cors": "^2.8.5",
        "helmet": "^7.1.0",
        "dotenv": "^16.4.1",
        "zod": "^3.22.4",
        "winston": "^3.11.0",
        "redis": "^4.6.13",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "nodemailer": "^6.9.9",
        "multer": "^1.4.5-lts.1",
        "aws-sdk": "^2.1565.0",
        "yjs": "^13.6.10",
        "lib0": "^0.2.94",
        "y-protocols": "^1.0.6"
    },
    "devDependencies": {
        "@types/express": "^4.17.21",
        "@types/node": "^20.11.16",
        "@types/bcryptjs": "^2.4.6",
        "@types/jsonwebtoken": "^9.0.5",
        "@types/cors": "^2.8.17",
        "@types/passport": "^1.0.16",
        "@types/passport-jwt": "^4.0.1",
        "@types/nodemailer": "^6.4.14",
        "@types/multer": "^1.4.11",
        "@typescript-eslint/eslint-plugin": "^6.21.0",
        "@typescript-eslint/parser": "^6.21.0",
        "eslint": "^8.56.0",
        "typescript": "^5.3.3",
        "tsx": "^4.7.0",
        "prisma": "^5.9.1",
        "jest": "^29.7.0",
        "@types/jest": "^29.5.12",
        "ts-jest": "^29.1.2",
        "supertest": "^6.3.4",
        "@types/supertest": "^6.0.2"
    }
