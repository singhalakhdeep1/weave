# --- Required ---
# The database must use UTF-8 encoding (the default on most Postgres installs).
DATABASE_URL=postgresql://postgres:password@localhost:5432/weave
# Two different random strings, at least 16 characters each:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# --- Server ---
PORT=5001
NODE_ENV=development
# Origin of the web app (CORS)
FRONTEND_URL=http://localhost:5173
JWT_EXPIRY=15m
REFRESH_TOKEN_DAYS=7
# Set to true only if the web app and API are on different sites (cookie becomes SameSite=None; Secure)
CROSS_SITE_COOKIES=false
