datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  OWNER
  EDITOR
  VIEWER
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String
  createdAt DateTime @default(now())

  memberships   WorkspaceMember[]
  documents     Document[]
  comments      Comment[]
  refreshTokens RefreshToken[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Workspace {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  members   WorkspaceMember[]
  documents Document[]

  @@map("workspaces")
}

model WorkspaceMember {
  userId      String
  workspaceId String
  role        Role     @default(EDITOR)
  joinedAt    DateTime @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([userId, workspaceId])
  @@index([workspaceId])
  @@map("workspace_members")
}

model Document {
  id          String    @id @default(uuid())
  workspaceId String
  parentId    String?
  title       String    @default("Untitled")
  icon        String?
  position    Int       @default(0)
  // Yjs document state (binary). Source of truth for the content.
  ydoc        Bytes?
  // Plain text extracted from the document, used for search
  text        String    @default("")
  // Present while the public read-only link is enabled
  shareToken  String?   @unique
  deletedAt   DateTime?
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  workspace Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  parent    Document?         @relation("Tree", fields: [parentId], references: [id], onDelete: Cascade)
  children  Document[]        @relation("Tree")
  createdBy User              @relation(fields: [createdById], references: [id])
  versions  DocumentVersion[]
  comments  Comment[]

  @@index([workspaceId, deletedAt])
  @@index([parentId])
  @@map("documents")
}

model DocumentVersion {
  id          String   @id @default(uuid())
  documentId  String
  ydoc        Bytes
  label       String? // set for manual snapshots; null for automatic ones
  createdById String?
  createdAt   DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId, createdAt])
  @@map("document_versions")
}

model Comment {
  id         String   @id @default(uuid())
  documentId String
  userId     String
  content    String
  quote      String? // the text the comment refers to
  parentId   String?
  resolved   Boolean  @default(false)
  createdAt  DateTime @default(now())

  document Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   Comment?  @relation("Thread", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("Thread")

  @@index([documentId, createdAt])
  @@map("comments")
}
